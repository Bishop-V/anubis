{
  "name": "anubis",
  "description": "Anubis: weigh your search results with tags, reranking and lists anyone can publish",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "wxt build -b chrome && node e2e/run.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.0",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
