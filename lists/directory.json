{
  "version": 1,
  "description": "Lists Anubis offers under Settings → Lists → More lists. Add yours with a pull request.",
  "lists": [
    {
      "id": "official-docs",
      "name": "Official docs",
      "description": "Tags and raises official documentation.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/official-docs.anubis",
      "format": "anubis",
      "builtin": true,
      "default": true,
      "overlaps": ["devdocs"]
    },
    {
      "id": "discussions",
      "name": "Discussions",
      "description": "Tags forums and Q&A threads.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/discussions.anubis",
      "format": "anubis",
      "builtin": true,
      "default": true
    },
    {
      "id": "reference",
      "name": "Reference",
      "description": "Tags encyclopedias, archives, and papers.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/reference.anubis",
      "format": "anubis",
      "builtin": true,
      "default": true
    },
    {
      "id": "paywalls",
      "name": "Paywalls",
      "description": "Tags paywalled news and magazine sites.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/paywalls.anubis",
      "format": "anubis",
      "builtin": true,
      "default": true
    },
    {
      "id": "foss-tools",
      "name": "FOSS tools",
      "description": "Tags FOSS tools.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/foss-tools.anubis",
      "format": "anubis",
      "builtin": true,
      "default": true,
      "overlaps": ["self-hosted-foss"]
    },
    {
      "id": "ai-content",
      "name": "AI content",
      "description": "Tags AI-generated sites, from the HUGE AI Blocklist.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/sources/ai-content.anubis",
      "homepage": "https://github.com/laylavish/uBlockOrigin-HUGE-AI-Blocklist",
      "format": "anubis",
      "default": true,
      "overlaps": ["huge-ai-blocklist"]
    },
    {
      "id": "independent-wikis",
      "name": "Independent wikis",
      "description": "Raises independent wikis over Fandom, from Indie Wiki Buddy.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/sources/independent-wikis.anubis",
      "homepage": "https://github.com/KevinPayravi/indie-wiki-buddy",
      "format": "anubis",
      "default": true
    },
    {
      "id": "devdocs",
      "name": "DevDocs",
      "description": "Tags and raises the docs DevDocs collects.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/sources/devdocs.anubis",
      "homepage": "https://github.com/freeCodeCamp/devdocs",
      "format": "anubis",
      "default": true,
      "overlaps": ["official-docs"]
    },
    {
      "id": "self-hosted-foss",
      "name": "Self-hosted FOSS",
      "description": "Tags self-hostable FOSS, from awesome-selfhosted.",
      "url": "https://raw.githubusercontent.com/Bishop-V/anubis/main/lists/sources/self-hosted-foss.anubis",
      "homepage": "https://github.com/awesome-selfhosted/awesome-selfhosted-data",
      "format": "anubis",
      "default": true,
      "overlaps": ["foss-tools"]
    },
    {
      "id": "huge-ai-blocklist",
      "name": "Huge AI Blocklist",
      "description": "Hides AI image and content farms. By laylavish.",
      "url": "https://raw.githubusercontent.com/laylavish/uBlockOrigin-HUGE-AI-Blocklist/main/list_uBlacklist.txt",
      "homepage": "https://github.com/laylavish/uBlockOrigin-HUGE-AI-Blocklist",
      "format": "ublacklist",
      "overlaps": ["ai-content"]
    },
    {
      "id": "ai-content-farms",
      "name": "AI content farms",
      "description": "Hides AI content farms, many Italian. By alvi-se.",
      "url": "https://raw.githubusercontent.com/alvi-se/ai-ublock-blacklist/master/ublacklist.txt",
      "homepage": "https://github.com/alvi-se/ai-ublock-blacklist",
      "format": "ublacklist"
    },
    {
      "id": "ai-answers",
      "name": "AI news and answers",
      "description": "Hides AI-generated news and answer sites. By agsimmons.",
      "url": "https://raw.githubusercontent.com/agsimmons/ai-content-blocklist/main/uBlacklist.txt",
      "homepage": "https://github.com/agsimmons/ai-content-blocklist",
      "format": "ublacklist"
    },
    {
      "id": "bad-websites",
      "name": "Bad Website Blocklist",
      "description": "Hides AI articles, spam, and ads posing as information. By popcar2.",
      "url": "https://raw.githubusercontent.com/popcar2/BadWebsiteBlocklist/main/uBlacklist.txt",
      "homepage": "https://github.com/popcar2/BadWebsiteBlocklist",
      "format": "ublacklist"
    },
    {
      "id": "stackoverflow-copies",
      "name": "Stack Overflow copies",
      "description": "Hides Stack Overflow scrapers.",
      "url": "https://raw.githubusercontent.com/arosh/ublacklist-stackoverflow-translation/master/uBlacklist.txt",
      "homepage": "https://github.com/arosh/ublacklist-stackoverflow-translation",
      "format": "ublacklist"
    },
    {
      "id": "github-copies",
      "name": "GitHub copies",
      "description": "Hides GitHub mirrors.",
      "url": "https://raw.githubusercontent.com/arosh/ublacklist-github-translation/master/uBlacklist.txt",
      "homepage": "https://github.com/arosh/ublacklist-github-translation",
      "format": "ublacklist"
    },
    {
      "id": "dev-copies",
      "name": "Developer site copies",
      "description": "Hides copies of Stack Overflow, GitHub, npm, and Wikipedia. By quenhus.",
      "url": "https://raw.githubusercontent.com/quenhus/uBlock-Origin-dev-filter/main/dist/other_format/uBlacklist/global.txt",
      "homepage": "https://github.com/quenhus/uBlock-Origin-dev-filter",
      "format": "ublacklist"
    },
    {
      "id": "brave-copycats",
      "name": "Copycats removal",
      "description": "Hides copycat content, like translated Stack Overflow threads.",
      "url": "https://raw.githubusercontent.com/brave/goggles-quickstart/main/goggles/copycats_removal.goggle",
      "homepage": "https://github.com/brave/goggles-quickstart",
      "format": "goggle"
    },
    {
      "id": "brave-no-pinterest",
      "name": "No Pinterest",
      "description": "Hides Pinterest.",
      "url": "https://raw.githubusercontent.com/brave/goggles-quickstart/main/goggles/no_pinterest.goggle",
      "homepage": "https://github.com/brave/goggles-quickstart",
      "format": "goggle"
    },
    {
      "id": "brave-tech-blogs",
      "name": "Tech blogs (lens)",
      "description": "Shows only about 1,400 tech blogs.",
      "url": "https://raw.githubusercontent.com/brave/goggles-quickstart/main/goggles/tech_blogs.goggle",
      "homepage": "https://github.com/brave/goggles-quickstart",
      "format": "goggle",
      "lens": true
    },
    {
      "id": "brave-hacker-news",
      "name": "Hacker News (lens)",
      "description": "Shows only sites popular on Hacker News.",
      "url": "https://raw.githubusercontent.com/brave/goggles-quickstart/main/goggles/hacker_news.goggle",
      "homepage": "https://github.com/brave/goggles-quickstart",
      "format": "goggle",
      "lens": true
    }
  ]
}
