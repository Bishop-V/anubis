{
  "name": "anubis-ssx-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:site": "node scripts/prepare.mjs",
    "build": "npm run prepare:site && ssx build --force && node scripts/package.mjs",
    "dev": "npm run build && npm run preview",
    "preview": "ssx serve"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@inglorious/i18n": "1.3.0",
    "@inglorious/motion": "9.0.18",
    "@inglorious/ssx": "2.3.2",
    "@inglorious/store": "12.1.1",
    "@inglorious/ui": "9.8.0",
    "@inglorious/utils": "5.1.0",
    "@inglorious/web": "6.11.0",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-container": "4.0.0"
  }
}
